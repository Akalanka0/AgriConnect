VITE_API_URL=http://localhost:5005/api
VITE_SOCKET_URL=http://localhost:5005
# Optional: OpenWeatherMap API key for the weather widget
VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key_here
# Set to true to show demo credentials panel and quick-fill button on the login/register page.
# Set to false (or remove) for client/production deployments.
VITE_DEMO_MODE=true
