{
    "name": "agri-backend",
    "version": "1.0.0",
    "description": "AgriConnect Backend",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "cross-env NODE_ENV=test node --test",
        "migrate": "node migrations/run-migrations.js",
        "seed": "node -r dotenv/config seeders/run-seeders.js",
        "seed:admin": "node seeders/admin.seeder.js",
        "seed:demo": "node -r dotenv/config seeders/demo/run-demo-seeders.js",
        "db:ensure": "node scripts/ensure-database.js",
        "db:drop": "node scripts/drop-db.js",
        "db:reset": "npm run db:drop && npm run db:ensure && npm run migrate && npm run seed && npm run seed:demo"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@faker-js/faker": "^10.2.0",
        "axios": "^1.13.4",
        "bcryptjs": "^3.0.3",
        "cloudinary": "^2.9.0",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^16.4.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.3.1",
        "form-data": "^4.0.5",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.0.2",
        "mysql2": "^3.16.1",
        "node-fetch": "^3.3.2",
        "nodemailer": "^7.0.12",
        "sequelize": "^6.37.7",
        "socket.io": "^4.8.3",
        "streamifier": "^0.1.1",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "cross-env": "^10.1.0",
        "nodemon": "^3.0.3",
        "supertest": "^7.2.2"
    }
}
