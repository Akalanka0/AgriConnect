DB_NAME=agriconnect
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306
# Generate a 128-char hex secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_GENERATED_SECRET_128_CHARS
JWT_EXPIRE=7d
DEV_EMAIL_BYPASS=
NODE_ENV=development
PORT=5005
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
FRONTEND_URL=http://localhost:5173
# Optional: comma-separated allow-list for CORS/Socket origins (overrides FRONTEND_URL when set)
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://app.example.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
